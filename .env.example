# Copy to .env and fill in. Never commit real secrets.

# Database (MongoDB replica set; see docker-compose.dev.yml)
DATABASE_URL=

# Auth.js
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Google OAuth (optional: leave both empty to hide the Google button).
# Authorized redirect URIs to register in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only when self-hosting behind a reverse proxy you control (not needed on Vercel):
# AUTH_TRUST_HOST=true
# Canonical site URL in production (e.g. https://ridmo.example), if your proxy does not forward the host.
# AUTH_URL=

# Public contact details
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_PHONE_NUMBER=
# Used by the "send transfer proof" link on the order confirmation page. Digits only, with country code.
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=

# Object storage (MinIO / S3-compatible) for admin uploads.
# Local dev: `docker compose -f docker-compose.dev.yml up -d` starts MinIO and creates the bucket.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ridmo-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Public base URL of the bucket (objects must be anonymously readable)
S3_PUBLIC_URL=http://localhost:9000/ridmo-media

# Web Push (admin new-order notifications)
# Generate once with: node -e "const w=require('web-push');console.log(w.generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# https:// URL of the site (or mailto:)
VAPID_SUBJECT=

# Transactional email (order-received message to the customer). Leave empty to skip sending.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); defaults to true only on 465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to customers, e.g. "RIDMO <pedidos@ridmo.com.py>"
EMAIL_FROM=

# Bank transfer instructions shown on the order confirmation page (server-side only)
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_HOLDER=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ALIAS=
BANK_TRANSFER_NOTES=
