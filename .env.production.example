# Copy to .env.production and fill in. Never commit real secrets.
# Used with: docker compose --env-file .env.production up -d --build

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > Install connector)
CLOUDFLARE_TUNNEL_TOKEN=

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# RustFS (S3-compatible storage). Use a long random password (openssl rand -hex 24)
RUSTFS_ROOT_USER=ridmo-admin
RUSTFS_ROOT_PASSWORD=
RUSTFS_BUCKET=ridmo-media

# Public contact details
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Bank transfer instructions
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_HOLDER=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ALIAS=
BANK_TRANSFER_NOTES=
